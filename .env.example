# Tigers Eye Life — example env file.
# Copy to `.env` (which is gitignored) and fill in your values.

# Supabase (optional — leave empty to run in dev-skip / AsyncStorage mode)
# See CLAUDE.md → "Dual-path data layer" for what dev-skip mode does.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key — powers the Fuel "Scan with AI" food-vision feature
# (Claude Haiku 4.5 vision identifies foods and estimates macros from a photo).
#
# ⚠️ SECURITY NOTE: any `EXPO_PUBLIC_*` env var is bundled into the app binary
# at build time and IS extractable by anyone who downloads the app. This is
# acceptable for the beta cohort, but BEFORE PUBLIC LAUNCH move this call
# to a Supabase Edge Function (or similar server-side proxy) and remove the
# key from the client. Track in docs/product-reference-checklist.md.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
